# The private data layer of an AIOS stays local. These paths hold personal context,
# third-party email and chat content, and course material.
.env*
!.env.example
context/
decisions/
daily-log/
audits/
archives/
parking-lot.md
connections.md
aios-intake.md
references/
.planning/
.tmp/
dashboard/

# build output and caches
.claude/skills/study-prep/example/*.html
__pycache__/
*.pyc
.DS_Store
